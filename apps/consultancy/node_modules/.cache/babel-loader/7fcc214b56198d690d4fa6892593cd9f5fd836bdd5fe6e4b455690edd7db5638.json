{"ast":null,"code":"import{useEffect,useRef,useState}from'react';const useScrollAnimation=function(){let threshold=arguments.length>0&&arguments[0]!==undefined?arguments[0]:0.1;const[isVisible,setIsVisible]=useState(false);const ref=useRef(null);useEffect(()=>{const observer=new IntersectionObserver(_ref=>{let[entry]=_ref;if(entry.isIntersecting){setIsVisible(true);}},{threshold});const currentRef=ref.current;if(currentRef){observer.observe(currentRef);}return()=>{if(currentRef){observer.unobserve(currentRef);}};},[threshold]);return[ref,isVisible];};export default useScrollAnimation;","map":{"version":3,"names":["useEffect","useRef","useState","useScrollAnimation","threshold","arguments","length","undefined","isVisible","setIsVisible","ref","observer","IntersectionObserver","_ref","entry","isIntersecting","currentRef","current","observe","unobserve"],"sources":["C:/Users/mayur/OneDrive/Desktop/Intership/artemis-consultants (2)/artemis-consultants/apps/consultancy/src/hooks/useScrollAnimation.js"],"sourcesContent":["import { useEffect, useRef, useState } from 'react';\r\n\r\nconst useScrollAnimation = (threshold = 0.1) => {\r\n  const [isVisible, setIsVisible] = useState(false);\r\n  const ref = useRef(null);\r\n\r\n  useEffect(() => {\r\n    const observer = new IntersectionObserver(\r\n      ([entry]) => {\r\n        if (entry.isIntersecting) {\r\n          setIsVisible(true);\r\n        }\r\n      },\r\n      {\r\n        threshold,\r\n      }\r\n    );\r\n\r\n    const currentRef = ref.current;\r\n    if (currentRef) {\r\n      observer.observe(currentRef);\r\n    }\r\n\r\n    return () => {\r\n      if (currentRef) {\r\n        observer.unobserve(currentRef);\r\n      }\r\n    };\r\n  }, [threshold]);\r\n\r\n  return [ref, isVisible];\r\n};\r\n\r\nexport default useScrollAnimation;\r\n"],"mappings":"AAAA,OAASA,SAAS,CAAEC,MAAM,CAAEC,QAAQ,KAAQ,OAAO,CAEnD,KAAM,CAAAC,kBAAkB,CAAG,QAAAA,CAAA,CAAqB,IAApB,CAAAC,SAAS,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAA